{"program":[{"day":1,"weekday":1,"focus":"Chest & triceps","goal":"One-arm push-up","sheet":"Day 1 Chest Push","exercises":[{"id":"d1e1","name":"Archer push-ups (assisted if needed)","sets":3,"target":"3–6/side","unit":"reps/side","cue":"Unilateral chest strength; assess clean reps first.","image":"archer-pushup.png","unilateral":true},{"id":"d1e5","name":"Standard floor push-ups","sets":2,"target":"10–20","unit":"reps","cue":"Hands on the floor; keep your body straight and lower your chest with control.","image":"standard-pushup.png","unilateral":false},{"id":"d1e2","name":"Deep parallettes push-ups","sets":3,"target":"8–12","unit":"reps","cue":"Control the descent and avoid forcing shoulder depth.","image":"deep-pushup.png","unilateral":false},{"id":"d1e3","name":"Uneven push-ups","sets":2,"target":"6–10/side","unit":"reps/side","cue":"Keep hips and torso stable.","image":"uneven-pushup.png","unilateral":true},{"id":"d1e4","name":"Diamond push-ups","sets":2,"target":"8–12","unit":"reps","cue":"Keep elbows controlled near the torso.","image":"diamond-pushup.png","unilateral":false}]},{"day":2,"weekday":2,"focus":"Back & shoulder mobility","goal":"Upper-back endurance and active shoulder mobility","sheet":"Day 2 Back","equipment":"Exercise mat, small blocks, and a wall","trainingInstructions":"Rest 60–90 seconds between sets. Move with control and pause for 1–2 seconds at the top of the moving exercises. Hold the prone back extension for the target time. Keep your neck relaxed.","note":"This is a back endurance and shoulder mobility session. Unloaded exercises do not replace loaded rows or pulling work for the lats and biceps.","exercises":[{"id":"d2e1","name":"Prone shoulder hurdles (Y-to-T)","sets":3,"target":"8–10 transitions","unit":"transitions","cue":"Move your arms slowly over the small blocks from Y to T without touching them. Keep your chest down.","image":"prone-shoulder-hurdles.png","unilateral":false},{"id":"d2e2","name":"Prone W raises","sets":3,"target":"10–12","unit":"reps","cue":"Lift your bent arms into a W, gently squeezing the shoulder blades. Keep your chest low and neck relaxed.","image":"prone-w-raises.png","unilateral":false},{"id":"d2e3","name":"Reverse snow angels","sets":3,"target":"10–15","unit":"reps","cue":"Lie face down with chest and hips on the mat. Keep your arms straight and sweep them from beside your hips in a wide arc toward your head, then return. Avoid shrugging or arching your back.","image":"reverse-snow-angel-correct.png","unilateral":false},{"id":"d2e4","name":"Prone back extensions","sets":3,"target":"10–20 sec","unit":"sec","cue":"Lie face down with straight arms resting on the floor behind you, hands beside your hips. Squeeze your shoulder blades, lift your shoulders and upper chest slightly, and hold for 10–20 seconds. Keep your hips, legs, arms, and hands on the floor; lower with control.","image":"prone-back-extension-arms-back.png","unilateral":false},{"id":"d2e5","name":"Wall angels (wall slides)","sets":3,"target":"10–12","unit":"reps","cue":"Stand with your back against a wall. Slide your arms slowly from W toward Y and return. Targets serratus anterior, lower traps, rotator cuff, and shoulder mobility.","image":"wall-angels.png","unilateral":false}]},{"day":3,"weekday":3,"focus":"Abs & core","goal":"L-sit → V-sit","sheet":"Day 3 Abs Core","exercises":[{"id":"d3e1","name":"L-sit holds on low parallettes","sets":5,"target":"3–5 sec","unit":"sec","cue":"Straight knees and active shoulder depression.","image":"l-sit.png","unilateral":false},{"id":"d3e2","name":"Seated pike compression lifts","sets":3,"target":"8–12","unit":"reps","cue":"Start bent-knee if straight-leg lifts are not yet clean.","image":"compression.png","unilateral":false},{"id":"d3e3","name":"Reverse crunches","sets":3,"target":"10–15","unit":"reps","cue":"Curl pelvis without swinging legs.","image":"reverse-crunch.png","unilateral":false},{"id":"d3e4","name":"Hollow body holds","sets":3,"target":"20–40 sec","unit":"sec","cue":"Keep low back gently connected to floor.","image":"hollow.png","unilateral":false},{"id":"d3e5","name":"Side planks","sets":2,"target":"20–40 sec/side","unit":"sec/side","cue":"Stack hips and shoulders; keep body long.","image":"side-plank.png","unilateral":true}]},{"day":4,"weekday":4,"focus":"Complete lower body","goal":"Pistol squat","sheet":"Day 4 Legs","exercises":[{"id":"d4e1","name":"Assisted pistol squats","sets":4,"target":"6–10/leg","unit":"reps/leg","cue":"Hold a sturdy chair back beside you; press through the foot to rise.","image":"pistol-squat.png","unilateral":true},{"id":"d4e2","name":"Slow reverse lunges","sets":3,"target":"8–12/leg","unit":"reps/leg","cue":"Use a 3-second descent and keep hips stable.","image":"reverse-lunge.png","unilateral":true},{"id":"d4e3","name":"Hamstring walkouts","sets":3,"target":"6–10","unit":"reps","cue":"Keep hips raised as heels walk away.","image":"hamstring-walkout.png","unilateral":false},{"id":"d4e4","name":"Single-leg glute bridges","sets":2,"target":"10–15/leg","unit":"reps/leg","cue":"Lift from the glute and keep pelvis level.","image":"single-leg-glute-bridge.png","unilateral":true},{"id":"d4e5","name":"Side-lying adductor raises","sets":2,"target":"10–15/leg","unit":"reps/leg","cue":"Lift the lower leg slowly.","image":"adductor-raise.png","unilateral":true},{"id":"d4e6","name":"Side-lying hip abductions","sets":2,"target":"12–20/leg","unit":"reps/leg","cue":"Keep hips stacked while raising the top leg.","image":"hip-abduction.png","unilateral":true},{"id":"d4e7","name":"Straight-knee single-leg calf raises","sets":2,"target":"12–20/leg","unit":"reps/leg","cue":"Pause at the top; lower slowly.","image":"calf-raise.png","unilateral":true},{"id":"d4e8","name":"Bent-knee calf raises","sets":2,"target":"15–20","unit":"reps","cue":"Keep a soft knee bend through the raise.","image":"bent-knee-calf.png","unilateral":false}]},{"day":5,"weekday":5,"focus":"Shoulders & straight-arm strength","goal":"P